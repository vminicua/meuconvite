# =====================================================================
# MeuConvite - example environment file (NO REAL VALUES HERE)
# Copy to `.env` and fill in the real values there. `.env` is git-ignored.
#   cp .env.example .env && chmod 600 .env
#
# Confirmed production environment (cPanel / CloudLinux):
#   database   : MariaDB 11.4  -> DB_ENGINE = django.db.backends.mysql
#   python     : 3.12 (3.10 / 3.11 / 3.13 also available)
#   web server : LiteSpeed + Passenger
#   redis      : not available (no Celery; use cron + management commands)
# =====================================================================

# --- Django core -----------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False

# Comma separated. Production: meuconvite.co.mz,www.meuconvite.co.mz
DJANGO_ALLOWED_HOSTS=
# Comma separated, WITH scheme.
DJANGO_CSRF_TRUSTED_ORIGINS=

SITE_BASE_URL=https://meuconvite.co.mz
SITE_DOMAIN=meuconvite.co.mz
SITE_NAME=MeuConvite

# Django admin path (change it to reduce automated scanning noise)
DJANGO_ADMIN_URL=django-admin/

# --- Database --------------------------------------------------------
# MySQL / MariaDB (this deployment):
#   DB_ENGINE=django.db.backends.mysql
#   DB_PORT=3306
# PostgreSQL:
#   DB_ENGINE=django.db.backends.postgresql
#   DB_PORT=5432
DB_ENGINE=django.db.backends.mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60
# Optional, MySQL only: absolute path to a CA bundle to force TLS
DB_SSL_CA=

# --- Email -----------------------------------------------------------
# cPanel: porta 465 = SSL implícito (USE_SSL=True), porta 587 = STARTTLS.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=MeuConvite <noreply@meuconvite.co.mz>
SERVER_EMAIL=noreply@meuconvite.co.mz
SUPPORT_EMAIL=info@meuconvite.co.mz

# --- Security --------------------------------------------------------
SECURE_SSL_REDIRECT=True
# Only enable HSTS once HTTPS is confirmed working on the domain.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_PROTO=True

# --- Files -----------------------------------------------------------
STATIC_ROOT=
MEDIA_ROOT=
LOG_DIR=
USE_WHITENOISE=True

# --- Localisation ----------------------------------------------------
LANGUAGE_CODE=pt
TIME_ZONE=Africa/Maputo

# --- Optional infrastructure (leave empty if unavailable) -------------
REDIS_URL=

# --- Local development -----------------------------------------------
# Development always uses SQLite and ignores the credentials above.
# Set to True only when working through an SSH tunnel to the remote database.
DEV_DB_FROM_ENV=False
# Password used by `manage.py seed_demo` (development only).
DEMO_USER_PASSWORD=
